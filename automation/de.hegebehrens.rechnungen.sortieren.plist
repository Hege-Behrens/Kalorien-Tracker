<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.hegebehrens.rechnungen.sortieren</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/automation/rechnungen_lauf.sh</string>
        <string>sortieren</string>
    </array>

    <!-- Zweimal täglich: morgens um 7 und abends um 19 Uhr. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>19</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- Schlief der Mac zur geplanten Zeit, läuft der Job beim Aufwachen nach. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/Rechnungen/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/Rechnungen/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
