# Absender der Bestandsliste. Der SMTP-Server wird aus der Domain abgeleitet.
# Das Passwort ist ein App-Passwort des jeweiligen Anbieters, nicht das
# normale Kontopasswort:
#   Gmail:  myaccount.google.com/apppasswords
#   iCloud: appleid.apple.com
MAIL_ABSENDER=hegebehrens.rechnung@gmail.com
MAIL_PASSWORT=xxxx xxxx xxxx xxxx

# Empfaenger stehen in data/einstellungen.csv und werden mit
#   ./inventur.py empfaenger a@b.de c@d.de
# gesetzt. Diese Variable ist nur der Ausweichweg, falls dort nichts steht.
# BESTANDSLISTE_EMPFAENGER=name@beispiel.de,zweite@beispiel.de

# Vensoft-Schnittstelle (Nur-Lese-Zugang fuer die Verkaufsdaten).
# Gehoert NICHT ins Repository - als Umgebungsvariable oder GitHub-Secret setzen.
VENSOFT_USER=hegebehrens
VENSOFT_PASS=xxxxxxxxxxxx
# VENSOFT_URL=https://adapter.vensoft.de/100/Dump/
